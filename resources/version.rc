#include <windows.h>

IDI_ICON1 ICON "icons/app-icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,12,0
PRODUCTVERSION  1,0,12,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Aura"
            VALUE "FileDescription",  "Aura Island - Liquid Glass Productivity Hub"
            VALUE "FileVersion",      "1.0.12.0"
            VALUE "InternalName",     "AuraIsland"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Aura. All rights reserved."
            VALUE "OriginalFilename", "AuraIsland.exe"
            VALUE "ProductName",      "Aura Island"
            VALUE "ProductVersion",   "1.0.12.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
